{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/updates/:path*", "destination": "/api/updates?path=:path*" },
    { "source": "/preturi", "destination": "/preturi.html" },
    { "source": "/parteneri", "destination": "/parteneri.html" },
    { "source": "/functionalitati", "destination": "/functionalitati.html" },
    { "source": "/ajutor", "destination": "/ajutor.html" },
    { "source": "/descarcare", "destination": "/descarcare.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/intrebari-frecvente", "destination": "/intrebari-frecvente.html" },
    { "source": "/confidentialitate", "destination": "/confidentialitate.html" },
    { "source": "/politica-confidentialitate", "destination": "/politica-confidentialitate.html" },
    { "source": "/termeni", "destination": "/termeni.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
